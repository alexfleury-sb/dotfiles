# Print system information.
if command -v fastfetch &> /dev/null; then
	fastfetch
fi

export DISABLE_UPDATE_PROMPT=true

export PATH="$HOME/.local/bin:$PATH"

# Oh My Zsh.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
ZSH_CUSTOM=$HOME/.dotfiles/oh-my-zsh-custom
plugins=(git pyenv)
source $ZSH/oh-my-zsh.sh

# Hide username@hostname.
prompt_context(){}

# BASH/ZSH Common aliases and functions.
source $HOME/.dotfiles/shell/common
source $HOME/.dotfiles/shell/functions

# Per-machine configuration.
if [ -f ~/.zshrc_local ]; then
    source ~/.zshrc_local
fi

# fzf: https://github.com/junegunn/fzf.
if command -v fzf &> /dev/null; then
	source <(fzf --zsh)
fi

# zoxide: https://github.com/ajeetdsouza/zoxide.
if command -v zoxide &> /dev/null; then
	eval "$(zoxide init zsh)"
fi

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc'; fi

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'micromamba shell init' !!
export MAMBA_EXE='/opt/homebrew/bin/micromamba';
export MAMBA_ROOT_PREFIX='/Users/alexandre.fleury/micromamba';
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias micromamba="$MAMBA_EXE"  # Fallback on help from micromamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# Fix "Error opening terminal: xterm-kitty" for setuid TUI tools.
# top (setuid root) ignores ~/.terminfo and $TERMINFO, and /usr/share/terminfo
# is read-only under SIP, so give these tools a TERM present in the system DB.
alias top='TERM=xterm-256color top'
